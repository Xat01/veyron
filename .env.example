# VEYRON Configuration Example
#
# Copy this file to .env and customise as needed. Never commit .env files;
# they are git-ignored. Every value here is optional — VEYRON works with
# deterministic scanners alone, with no AI configured.

# --- Scanner configuration --------------------------------------------------

# Paths (absolute) to scanner executables when they are not on PATH.
# VEYRON_SEMGREP_PATH=/usr/local/bin/semgrep
# VEYRON_BANDIT_PATH=/usr/local/bin/bandit
# VEYRON_GITLEAKS_PATH=/usr/local/bin/gitleaks

# Maximum time (seconds) any single scanner invocation may run.
VEYRON_SCANNER_TIMEOUT_SECONDS=600

# Maximum size (bytes) of a single file that scanners will attempt to read.
VEYRON_MAX_FILE_SIZE_BYTES=2000000

# --- AI configuration --------------------------------------------------------

# AI assistance is optional. Set to "false" to disable all AI requests.
VEYRON_AI_ENABLED=true

# Base URL of the OmniRoute gateway (OpenAI-compatible). Verified free route
# only: route names that resolve to verified free models only.
VEYRON_AI_BASE_URL=http://localhost:3103/v1
VEYRON_AI_API_KEY=local-omniroute
VEYRON_AI_MODEL=free-reliable
VEYRON_AI_TIMEOUT_SECONDS=60
VEYRON_AI_MAX_RETRIES=2

# --- Dashboard / web interface ----------------------------------------------

VEYRON_DASHBOARD_HOST=127.0.0.1
VEYRON_DASHBOARD_PORT=8732

# --- Scope controls (dynamic testing) ----------------------------------------

# Authorised dynamic test targets (host:port pairs). Do not add arbitrary
# public websites — use localhost or an approved staging target only.
VEYRON_DAST_ALLOWLIST=127.0.0.1:8080
VEYRON_DAST_MAX_REQUESTS=200
VEYRON_DAST_MAX_MINUTES=30
VEYRON_DAST_MAX_CONCURRENCY=2
VEYRON_DAST_FOLLOW_REDIRECTS=false
